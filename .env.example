# ---------------------------------------------------------------------------
# Local DEV environment. Copy to .env and fill in.
#   cp .env.example .env && ./scripts/gen_secrets.sh >> .env
# .env is gitignored and must NEVER be committed.
# ---------------------------------------------------------------------------

SUPERSET_ENV=dev
SUPERSET_VERSION=6.1.0

# --- Secrets (generate, do not reuse across environments) ---
SUPERSET_SECRET_KEY=CHANGE_ME_openssl_rand_base64_42
METADATA_DB_PASSWORD=CHANGE_ME
WAREHOUSE_DB_PASSWORD=CHANGE_ME
SUPERSET_ADMIN_PASSWORD=CHANGE_ME

# --- Superset admin ---
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_EMAIL=admin@localhost

# --- Metadata database (Superset runtime state) ---
METADATA_DB_USER=superset
METADATA_DB_NAME=superset

# --- Analytical warehouse ---
WAREHOUSE_DB_USER=warehouse
WAREHOUSE_DB_NAME=dwh
WAREHOUSE_DB_PORT=55432

# --- Ports ---
SUPERSET_PORT=8088
MCP_PORT=5008
MCP_URL=http://localhost:5008/mcp

# --- Local dev transport (HTTPS/secure cookies are enforced in prod) ---
SUPERSET_SECURE_COOKIES=false
SUPERSET_TALISMAN_ENABLED=false

# --- MCP ---
# Default-deny: mutating MCP tools are not registered at all unless this is false.
MCP_READ_ONLY=true
MCP_AUTH_ENABLED=false
MCP_DEV_USERNAME=admin
MCP_DEBUG=false

# --- GitOps / API client ---
SUPERSET_URL=http://localhost:8088
SUPERSET_API_USERNAME=admin
SUPERSET_API_PASSWORD=${SUPERSET_ADMIN_PASSWORD}

# --- Warehouse connection string used when importing assets/databases/*.yaml ---
# This resolves the ${DATABASE_URI} placeholder held in version control.
DATABASE_URI=postgresql+psycopg2://warehouse:CHANGE_ME@warehouse-db:5432/dwh
